{
  "name": "@hive-controls/formic",
  "version": "0.2.0",
  "description": "The tool contract's configurator: resolve gate, healer and profile choices into a recipe's declared environment, then run it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hive-controls/formic.git"
  },
  "homepage": "https://github.com/hive-controls/formic#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./fleet": "./dist/fleet/fleet.mjs",
    "./profiles": "./dist/heal/profiles/profiles.mjs",
    "./remote": "./dist/remote/index.mjs",
    "./run": "./dist/run/run.mjs",
    "./status": "./dist/status/stream.mjs"
  },
  "main": "./dist/run/run.mjs",
  "types": "./dist/run/run.d.mts",
  "bin": {
    "formic": "dist/cli/formic.mjs"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --import tsx --test --test-timeout=360000 \"src/**/*.test.mts\" \"probes/**/*.test.mts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "formic": "node dist/cli/formic.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "@hive-controls/toolspec": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "eslint": "^10.9.1"
  }
}
