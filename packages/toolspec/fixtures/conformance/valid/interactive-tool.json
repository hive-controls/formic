{
  "toolspec": 1,
  "name": "psql-console",
  "title": "psql console",
  "description": "An interactive Postgres shell against the repo's configured database.",
  "launch": {
    "command": "psql",
    "args": ["--host", "localhost", "--dbname", "app_development"],
    "cwd": "{repo}"
  },
  "config": {
    "schema": "./psql-console.schema.json",
    "files": [".env", "db.env"]
  },
  "status": {
    "kind": "exit-code"
  },
  "health": {
    "check": ["psql", "--version"]
  },
  "pane": {
    "prefer": "window",
    "interactive": true
  }
}
