});

test("REFUSAL — a Playwright-only frame selector is refused by the plain-CSS targets", () => {
  // A frame link's `selector` addresses an <iframe> in a document, which is the same job
  // a step's `target` does — so it is held to the same per-target rules. It used to be
  // quoted and emitted unexamined, and `xpath=//iframe` compiled into a plain-CSS lookup
  // that matches nothing: a chain resolving no frame at run time, out of a compiler whose
  // whole contract is to refuse what a target cannot say.
  const spec: Spec = {
    name: "xpath-frame",
    startUrl: "http://127.0.0.1:4173/",
    steps: [
      {
        id: "st_1",
        index: 1,
        action: "click",
        target: "#pay",
        frame: [{ selector: "xpath=//iframe" }],
        assert: { testId: "receipt", visible: true },
      },
    ],
  };
  assert.throws(
    () => compileSpec(spec, "puppeteer"),
    (err: unknown) =>
      err instanceof UnsupportedConstructError &&
      err.target === "puppeteer" &&
      /a selector-engine prefix/.test(err.message),
  );
  // Playwright speaks its own selector syntax, so it emits the same chain unchanged.
  assert.ok(
    compileSpec(spec, "playwright").source.includes(
      'page.frameLocator("xpath=//iframe")',
    ),
  );
});

test("REFUSAL — a Playwright-only selector in a LOOKUP chain is refused too", () => {
  // The helper path builds a literal rather than a frameLocator expression; the check
  // belongs to the link, not to the shape the target happens to emit it in.
  const spec: Spec = {
    name: "xpath-frame-lookup",
    startUrl: "http://127.0.0.1:4173/",
    steps: [
      {
        id: "st_1",
        index: 1,
        action: "click",
        target: "#pay",
        frame: [{ selector: "#outer >> #inner" }, { name: "payment" }],
        assert: { testId: "receipt", visible: true },
      },
    ],
  };
  assert.throws(
    () => compileSpec(spec, "puppeteer"),
    (err: unknown) =>
      err instanceof UnsupportedConstructError &&
      /the `>>` engine chain/.test(err.message),
  );
});

test("both emitted frame helpers refuse an ambiguous link rather than taking the first", () => {
  // The rule belongs to the link, not to the runtime: an exported test that silently ran
  // in the wrong frame is the same wrong artifact, in someone else's CI where nobody is
  // watching for it.
  const playwright = readFileSync(
    join(goldenDir, "frame-coverage.spec.ts"),
    "utf8",
  );
  const puppeteer = readFileSync(join(goldenDir, "frame-coverage.mjs"), "utf8");
  for (const [name, source] of [
    ["playwright", playwright],
    ["puppeteer", puppeteer],
  ] as const) {
    assert.match(
      source,
      /is ambiguous/,
      `${name} must refuse an ambiguous link`,
    );
    assert.match(
      source,
      /matches > 1/,
      `${name} must decide on the COUNT, not on the first match`,
    );
    assert.ok(
      !/\.first\(\)|current\.\$\(link\.selector\)/.test(source),
      `${name} must not resolve a frame selector to its first match`,
    );
  }
});
