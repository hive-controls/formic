test("REFUSAL — Cypress cannot press a key it will only learn at run time", () => {
  // `.type()` spells a key as a braced token chosen when the file is generated. Typing
  // the reference literally would send the key's SPELLING as text — a green test doing
  // the wrong thing, which is the class the refusals exist for.
  const spec = fixture("grammar-coverage");
  const referencedPress: Spec = {
    ...spec,
    steps: spec.steps.map((step: SpecStep) =>
      step.action === "press"
        ? { ...step, value: undefined, valueFrom: "env.SUBMIT_KEY" }
        : step,
    ),
  };
  assert.throws(
    () => compileSpec(referencedPress, "cypress"),
    (err: unknown) =>
      err instanceof UnsupportedConstructError &&
      /needs a key token chosen when the file is generated/.test(err.message),
  );
  // The other two send the key at run time, so they carry it through.
  assert.match(
    compileSpec(referencedPress, "playwright").source,
    /await page\.press\("#password", process\.env\.SUBMIT_KEY/,
  );
});

test("REFUSAL — a valueFrom no target can name is refused before any of them tries", () => {
  const spec = fixture("approve-an-order");
  const malformed: Spec = {
    ...spec,
    steps: spec.steps.map((step: SpecStep) =>
      step.target === "#email"
        ? { ...step, value: undefined, valueFrom: "vault.secrets/email" }
        : step,
    ),
  };
  // Two doors, and both are shut. `compileSpec` validates first, so a loaded spec
  // never reaches the walk; `compile` is the door a hand-built spec comes through.
  assert.throws(
    () => compileSpec(malformed, "playwright"),
    /valueFrom must match/,
  );
  for (const target of [playwrightTarget, puppeteerTarget, cypressTarget]) {
    assert.throws(
      () => compile(malformed, target, "hand-built.yaml", "2026-09-04"),
      (err: unknown) =>
        err instanceof UnsupportedConstructError &&
        /no target can read a source it cannot name/.test(err.message),
    );
  }
});

