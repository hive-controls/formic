test("the CLI rejects --out with no path instead of printing to stdout", () => {
  // `--out` with nothing after it used to fall through to the stdout branch and exit 0,
  // so a typo looked like a successful export that wrote no file.
  const cli = join(here, "..", "cli", "e2e-doctor.mts");
  const spec = join(fixtureDir, "approve-an-order.yaml");
  // import.meta.resolve already yields a file:// URL — the form Windows needs; handing
  // --import a bare `C:\...` path makes node read `c:` as an unsupported URL scheme.
  const run = (args: string[]) =>
    spawnSync(
      process.execPath,
      ["--import", import.meta.resolve("tsx"), cli, ...args],
      { encoding: "utf8" },
    );

  const missing = run(["export", spec, "--target", "cypress", "--out"]);
  assert.equal(missing.status, 2, missing.stderr);
  assert.match(missing.stderr, /--out requires a file path/);

  const flagShaped = run(["export", spec, "--out", "--target", "cypress"]);
  assert.equal(flagShaped.status, 2, flagShaped.stderr);
  assert.match(flagShaped.stderr, /--out requires a file path/);

  // The stdout path still works when --out is absent entirely.
  const toStdout = run(["export", spec, "--target", "cypress"]);
  assert.equal(toStdout.status, 0, toStdout.stderr);
  assert.match(toStdout.stdout, /describe\(/);
});

test("the emitted puppeteer and cypress files are syntactically valid JavaScript", () => {
  // Neither framework is installed here, so this is the strongest check available:
  // node's own parser on the exact text a consumer would commit.
  const dir = mkdtempSync(join(tmpdir(), "formic-export-"));
  for (const name of FIXTURES) {
    for (const target of ["puppeteer", "cypress"] as const) {
      const compiled = compileSpec(fixture(name), target, { outDir: dir });
      writeFileSync(compiled.path!, compiled.source);
      const checked = spawnSync(process.execPath, ["--check", compiled.path!], {
        encoding: "utf8",
      });
      assert.equal(
        checked.status,
        0,
        `${compiled.path} failed node --check:\n${checked.stderr}`,
      );
    }
  }
});

/**
 * The reference form, per target. The golden files hold the whole text; these assert
 * the two things a reader of the diff has to be able to check at a glance — that the
 * value is READ rather than embedded, and that the file says which variables it needs.
 */
test("a referenced value is read from the environment in every target", () => {
  const spec = fixture("grammar-coverage");
  const playwright = compileSpec(spec, "playwright").source;
  assert.match(
    playwright,
    /await page\.fill\("#password", process\.env\.GRAMMAR_COVERAGE_PASSWORD \?\? missingEnv\("GRAMMAR_COVERAGE_PASSWORD"\)\);/,
  );
  const puppeteer = compileSpec(spec, "puppeteer").source;
  assert.match(
    puppeteer,
    /await page\.type\("#password", process\.env\.GRAMMAR_COVERAGE_PASSWORD \?\? missingEnv\("GRAMMAR_COVERAGE_PASSWORD"\)\);/,
  );
  // Cypress commands run in the browser, which has no process environment of its own —
  // a Cypress project keeps its variables in `Cypress.env`.
  // `{ log: false }` keeps the resolved value out of the Cypress command log, which is
  // rendered into the run's own screenshots and video.
  const cypress = compileSpec(spec, "cypress").source;
  assert.match(
    cypress,
    /cy\.get\("#password"\)\.clear\(\)\.type\(Cypress\.env\("GRAMMAR_COVERAGE_PASSWORD"\) \?\? missingEnv\("GRAMMAR_COVERAGE_PASSWORD"\), \{ parseSpecialCharSequences: false, log: false \}\);/,
  );
  // Every generated file says what its own runner may still capture. The export leaves
  // the consumer's repository; a guarantee that only holds inside this harness has to
  // be stated where it stops holding.
  assert.match(playwright, /trace/i);
  assert.match(puppeteer, /trace|screenshot/i);
  assert.match(cypress, /screenshot|video/i);
  for (const source of [playwright, puppeteer, cypress]) {
    // The value never appears; the variable is named in the header so the person who
    // runs the file knows what to set.
    assert.match(source, /Requires these environment variables/);
    assert.match(source, /\/\/ {3}GRAMMAR_COVERAGE_PASSWORD/);
    assert.match(source, /missing (Cypress )?environment variable/);
  }
});

