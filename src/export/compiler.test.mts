test("a control character in a frame link is refused before any target sees it", () => {
  // Every frame value lands in an emitted string literal exactly as a locator does, and
  // a control character has no escape there — refused once, by name, for all targets.
  const spec: Spec = {
    name: "framed",
    startUrl: "http://127.0.0.1:4173/",
    steps: [
      {
        id: "st_1",
        index: 1,
        action: "click",
        target: "#go",
        frame: [{ name: `pay${String.fromCharCode(7)}ment` }],
        assert: { testId: "ok", visible: true },
      },
    ],
  };
  for (const target of TARGET_NAMES) {
    assert.throws(
      () => compileSpec(spec, target),
      (err: unknown) =>
        err instanceof UnsupportedConstructError &&
        /control character U\+0007/.test(err.message),
      `${target} must refuse a control character in a frame name`,
    );
