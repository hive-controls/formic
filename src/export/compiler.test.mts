test("an all-selector frame chain compiles to Playwright's own frameLocator idiom", () => {
  // The idiom AND the stronger form: a FrameLocator re-resolves lazily and auto-waits on
  // every use, which is what the replay runner's timeout-bounded resolution does.
  const { source } = compileSpec(fixture(FRAME_FIXTURE), "playwright");
  assert.ok(
    source.includes(
      'await page.frameLocator("#checkout").frameLocator("#payment").locator("#card-number").fill("4242");',
    ),
    source,
  );
});

test("a chain naming a child frame goes through the lookup helper — frameLocator takes only a selector", () => {
  const { source } = compileSpec(fixture(FRAME_FIXTURE), "playwright");
  assert.ok(
    source.includes(
      'const frame3 = await frameChain(page, [{ selector: "#checkout" }, { name: "payment-frame" }]);',
    ),
    source,
  );
  assert.ok(source.includes('await frame3.locator("#pay").click();'), source);
  // The helper is emitted once, and only because this spec needs it.
  assert.equal(source.split("async function frameChain(").length - 1, 1);
  assert.ok(
    !compileSpec(fixture("grammar-coverage"), "playwright").source.includes(
      "frameChain",
    ),
  );
});

