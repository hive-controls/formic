# Copy to .env (gitignored). Never commit real values.

# ── Execution backend ──────────────────────────────────────────────────────────
# The Fleet picks the gate: solari when SOLARI_API_KEY resolves, else local. Set
# FORMIC_GATE to force one (a typo is refused, never silently local).
#   solari: a recorded Solari cloud-browser session (Outside). Get a key at
#           https://console.getsolari.com → API keys (slr_live_...)
#   local:  headless Chromium on this machine (Inside), evidence via injected rrweb.
#   browserstack / saucelabs: trial cloud-grid vendors (Outside), evidence via injected
#           rrweb. Explicit-only — never the default search, even with valid credentials.
# FORMIC_GATE=local
SOLARI_API_KEY=slr_live_replace_me
# BROWSERSTACK_USERNAME=replace_me
# BROWSERSTACK_ACCESS_KEY=replace_me
# SAUCE_USERNAME=replace_me
# SAUCE_ACCESS_KEY=replace_me

# ── App host ─────────────────────────────────────────────────────────────────
# Where the app under test is served from, for `--app <dir>`. Unset, the host follows
# the gate: solari-sandbox on Outside, local on Inside. Set FORMIC_HOST to force one (a
# typo is refused, never silently the other host).
#   solari-sandbox: uploads --app's directory into a Solari sandbox and serves it from
#                   the sandbox's own tokened preview URL — what an Outside gate needs
#                   to reach it. Requires SOLARI_API_KEY (above).
#   local:          an in-process static server on loopback (Inside only).
# FORMIC_HOST=local

# ── Repair PR evidence ───────────────────────────────────────────────────────
# Where `heal --pr` commits the evidence bundle, repo-relative. Unset, it is derived from
# the spec: `specs/<name>.yaml` -> `evidence/<decision id>/` beside the specs directory;
# any other spec -> `evidence/` next to the file. Never outside the repository.
# FORMIC_EVIDENCE_DIR=evidence

# ── Healer ───────────────────────────────────────────────────────────────────
# openai-compatible (default): any chat-completions endpoint — OpenRouter, OpenAI,
# Ollama / LM Studio / llama.cpp (llama-server) / vLLM on your LAN, or Anthropic's
# OpenAI-compatible endpoint. Presets (setup wizard / formic.profiles.yaml):
# anthropic · openrouter · openai · ollama · lmstudio · llamacpp · vllm · custom.
# agent:claude | agent:codex | agent:kimi | agent:grok: a headless coding agent on
# your own subscription, run in a sandboxed heal workspace.
# agent:custom: any CLI, via FORMIC_HEALER_AGENT_CMD.
#
# Prefer `e2e-doctor setup` over hand-editing this section: it writes the credential
# here and the rest of the choice (preset/model/agent) into the committed, secret-free
# formic.profiles.yaml, which `heal --healer <name>` reads instead of these vars.
FORMIC_HEALER=openai-compatible
FORMIC_HEALER_BASE_URL=https://api.anthropic.com/v1
FORMIC_HEALER_MODEL=claude-sonnet-5
FORMIC_HEALER_API_KEY=replace_me
# FORMIC_HEALER_AGENT_CMD=mycli --headless {prompt}
# FORMIC_HEALER_MAX_ATTEMPTS=2
# FORMIC_HEALER_TIMEOUT_MS=180000
# FORMIC_HEAL_WORKSPACES=/path/kept/as/audit/material
#
# Preset key names (formic.profiles.yaml's apiKeyFrom: env.NAME points at one of these):
# ANTHROPIC_API_KEY=replace_me
# OPENROUTER_API_KEY=replace_me
# OPENAI_API_KEY=replace_me
